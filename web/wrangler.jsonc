{
  // SiteVault: plain Worker (no framework, no server). KV + R2; D1 only for visit stats.
  // wrangler creates and maintains the DNS record for a custom_domain route
  // itself; do NOT also add a manual record for this hostname.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitevault-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "sitevault.3pandalabs.com", "custom_domain": true },
    // Customer sites: <slug>.3pandasite.com (bought 2026-11-15). The wildcard
    // route needs a PROXIED wildcard DNS record (* AAAA 100::) in the zone,
    // which wrangler can't create; the apex is a custom domain (wrangler
    // owns that record) and redirects to the home page.
    { "pattern": "*.3pandasite.com/*", "zone_name": "3pandasite.com" },
    { "pattern": "3pandasite.com", "custom_domain": true }
  ],
  "kv_namespaces": [{ "binding": "SITES", "id": "3b04019ee45b408f9e53edd403d14db7" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "sitevault-photos" }],
  // Cloudflare Images: shrinks uploaded photos to web size (free tier covers
  // 5,000 transformations a month). Code falls back to the original if absent.
  "images": { "binding": "IMAGES" },
  // Visit stats (Pro feature): aggregate counters only, see migrations/.
  // Apply with: npx wrangler d1 migrations apply sitevault-stats --remote
  // The code skips stats silently if this binding is missing.
  "d1_databases": [
    { "binding": "STATS", "database_name": "sitevault-stats", "database_id": "fc8a4b60-76b2-4350-9cc8-f6ce388e9342", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_ORIGIN": "https://sitevault.3pandalabs.com",
    "DAILY_CREATE_LIMIT": "5",
    "SITES_DOMAIN": "3pandasite.com",
    // Paid plans switch. "off" = everything free, exactly as before paid plans.
    "BILLING": "on",
    // With BILLING "on": sites made before billing started count as paid until
    // the end of this day (UTC).
    "EARLY_ACCESS_UNTIL": "2027-01-31",
    // Festive season price: Basic paid on or before this day (UTC) is $29/year
    // for life. Remove (or empty) to end the offer; locked sites keep $29.
    "FESTIVE_UNTIL": "2027-01-31",
    // Stripe price ids (shared org account). Empty = that checkout answers 503.
    "STRIPE_PRICE_BASIC": "price_1UcBuTCrSBBxBBeWqKauA3yi",
    "STRIPE_PRICE_BASIC_FESTIVE": "price_1UcBuUCrSBBxBBeWuMsYwYt2",
    "STRIPE_PRICE_PRO": "price_1UcBuUCrSBBxBBeWP4kYz7zF",
    "STRIPE_PRICE_PRO_ADVAULT": "price_1UcBuVCrSBBxBBeWwu6DgSZT",
    "STRIPE_PRICE_CREDITS": "price_1Uc8ecCrSBBxBBeWb1OpSjo6"
    // Secrets (wrangler secret put): METRICS_TOKEN (shared org token, for
    // admin.3pandalabs.com), ADMIN_TOKEN (takedowns). Both optional: the
    // endpoints answer 503 while unset, so a missing secret never bricks a deploy.
    // STRIPE_SECRET_KEY (restricted key) and STRIPE_WEBHOOK_SECRET are optional
    // too: without them only checkout/portal and the webhook answer 503.
  }
}
